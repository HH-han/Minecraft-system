<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.minecraft.mapper.GroupMemberMapper">
    
    <select id="selectByGroupId" resultType="com.minecraft.entity.GroupMember">
        SELECT * FROM group_member WHERE group_id = #{groupId}
    </select>
    
    <select id="selectByUserId" resultType="com.minecraft.entity.GroupMember">
        SELECT * FROM group_member WHERE user_id = #{userId}
    </select>
    
    <select id="countByGroupAndUser" resultType="int">
        SELECT COUNT(*) FROM group_member WHERE group_id = #{groupId} AND user_id = #{userId}
    </select>
    
</mapper>
