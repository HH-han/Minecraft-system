<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.minecraft.mapper.GroupAlbumMapper">
    
    <select id="selectByGroupId" resultType="com.minecraft.entity.GroupAlbum">
        SELECT * FROM group_album WHERE group_id = #{groupId} AND deleted = 0
    </select>
    
    <select id="selectByGroupIdOrdered" resultType="com.minecraft.entity.GroupAlbum">
        SELECT * FROM group_album WHERE group_id = #{groupId} AND deleted = 0 ORDER BY created_at DESC
    </select>
    
</mapper>