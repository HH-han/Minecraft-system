<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.minecraft.mapper.GroupChatMessageMapper">
    
    <select id="selectByGroupId" resultType="com.minecraft.entity.GroupChatMessage">
        SELECT * FROM group_chat_message WHERE group_id = #{groupId} ORDER BY create_time DESC LIMIT #{limit}
    </select>
    
</mapper>
