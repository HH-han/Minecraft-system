<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.minecraft.mapper.ChatGroupMapper">
    
    <select id="selectByCreatorId" resultType="com.minecraft.entity.ChatGroup">
        SELECT * FROM chat_group WHERE creator_id = #{creatorId}
    </select>
    
    <select id="searchByName" resultType="com.minecraft.entity.ChatGroup">
        SELECT * FROM chat_group WHERE name LIKE CONCAT('%', #{name}, '%')
    </select>
    
    <select id="selectByUserId" resultType="com.minecraft.entity.ChatGroup">
        SELECT cg.* FROM chat_group cg 
        INNER JOIN group_member gm ON cg.id = gm.group_id 
        WHERE gm.user_id = #{userId}
    </select>
    
</mapper>
