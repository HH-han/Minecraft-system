<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.minecraft.mapper.HotelFacilityMapper">

    <select id="selectByHotelId" resultType="com.minecraft.entity.HotelFacility">
        SELECT * FROM hotel_facility WHERE hotel_id = #{hotelId} ORDER BY id
    </select>

</mapper>
