<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.minecraft.mapper.AttractionTicketMapper">

    <select id="selectByAttractionId" resultType="com.minecraft.entity.AttractionTicket">
        SELECT * FROM attraction_ticket WHERE attraction_id = #{attractionId} ORDER BY id
    </select>

</mapper>
